#!/bin/sh
# render DECK.html OUT.mov [frames.py options]
# A deck to ProRes 422 HQ at 30 fps, with its sound if it loads sound.js.
set -eu -o pipefail
[ $# -ge 2 ] || { echo "usage: render DECK.html OUT.mov [frames.py options]" >&2; exit 2; }
here=$(cd "$(dirname "$0")" && pwd)
deck=$1; out=$2; shift 2
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
python3 "$here/scripts/frames.py" "$deck" --audio "$tmp/sound.wav" "$@" |
    ffmpeg -loglevel error -y -f image2pipe -framerate 30 -i - \
        -c:v prores_ks -profile:v 3 -pix_fmt yuv422p10le "$tmp/picture.mov"
if [ -s "$tmp/sound.wav" ]; then
    ffmpeg -loglevel error -y -i "$tmp/picture.mov" -i "$tmp/sound.wav" -c:v copy -c:a pcm_s16le "$out"
else
    mv "$tmp/picture.mov" "$out"
fi
